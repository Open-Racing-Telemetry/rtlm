(text "Automatic USB programming service mode" (at 20.32 7.62 0) (effects (font (size 2.0 2.0)) (justify left top)) (uuid "60d928fd-0c06-46dd-9243-48594d19ebfe"))
(text "USB only: peripherals OFF; GPIO0 forced LOW; ESP boots ROM download.\nMux confirms external5V selected: peripherals ramp ON; ESP resets and boots application.\nEither power-mode transition resets ESP before peripheral power changes." (at 142.24 244 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "40c9c3d9-2f95-4ec8-95f8-e75a2c9b22be"))
(text "TPS22917 CT -> VIN. Reset pulse = raw flag XOR Schmitt-delayed flag.\nQ2/Q3 are open collector; manual BOOT and RESET remain usable.\nDo not disable ROM USB download with security eFuses if USB service is required." (at 142.24 270 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "3873ca34-f99c-454f-a1da-e57168c5f878"))
